<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorSvt</RootNamespace>
    <VersionPrefix>2.3.45</VersionPrefix>
    <GitRevisionCount>0</GitRevisionCount>
    <BuildTimeUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildTimeUtc>
    <!-- Prod already has environment-specific web.config / appsettings; do not overwrite on publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$(BuildTimeUtc)" />
  </ItemGroup>

  <Target Name="SetGitRevision" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitRevListLines" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevListExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitRevisionRaw Condition="'$(_GitRevListExitCode)' == '0'">@(_GitRevListLines)</_GitRevisionRaw>
    </PropertyGroup>
    <PropertyGroup>
      <GitRevisionCount Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitRevisionRaw)', '^[0-9]+$'))">$(_GitRevisionRaw)</GitRevisionCount>
      <Version>$(VersionPrefix).$(GitRevisionCount)</Version>
      <AssemblyVersion>$(VersionPrefix).$(GitRevisionCount)</AssemblyVersion>
      <FileVersion>$(VersionPrefix).$(GitRevisionCount)</FileVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ch1seL.Blazored.LocalStorage.Concurrent" Version="0.0.4" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="LargeXlsx" Version="2.0.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\blazorbootstrap\BlazorBootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Platform\Resources\Platform.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config" CopyToPublishDirectory="Never" />
    <Content Update="web.*.config" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
