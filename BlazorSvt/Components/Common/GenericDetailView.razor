@typeparam TItem
@typeparam TDetailItem
@inherits SvtComponentBase
@if (isLoading || detailSettings is null)
{
    <div class="p-3">Loading...</div>
}
else if (errorMessage is not null)
{
    <div class="p-3 text-danger">@errorMessage</div>
}
else if (detail is not null)
{
    @Template?.Invoke(detail)

    <div class="sibur-grid-detail-container">
        @foreach (var setting in detailSettings.GetGridDetailSettingsCopy())
        {
            <div class="sibur-grid-detail-label ">@setting.Header:</div>
            <div class="sibur-grid-detail-value">@(setting.DisplaySelector(detail))</div>
        }
    </div>
}