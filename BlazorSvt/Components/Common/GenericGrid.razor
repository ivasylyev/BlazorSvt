@typeparam TItem
@inherits SvtComponentBase
<PageTitle>@PageTitle</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">@PageTitle</h1>
    <div class="d-flex gap-2">
        <Button Class="sibur-dna-btn" @onclick="ClearFiltersAsync">@L["GenericGrid.ResetFilters"]</Button>
        <Button Class="sibur-dna-btn" @onclick="ShowSettingsAsync">@L["GenericGrid.Settings"]</Button>
    </div>
</div>

<SettingsModal @ref="settingsModal"
               ColumnSettings="GridSettings?.GetGridColumnSettingsCopy()"
               OnOk="OnOkClick"
               OnCancel="OnCancelClick"
               OnReset="OnResetClick" />
<div class="sibur-grid">
    <Grid @ref="grid"
          TItem="TItem"
          Class="table table-hover table-bordered table-striped"
          DataProvider="DataProvider"
          AllowFiltering="true"
          AllowPaging="true"
          AllowSorting="true"
          PaginationItemsTextFormat="{0} - {1} из {2} элементов"
          Responsive="true">

        @if (GridSettings is null)
        {
            <PlaceholderContainer Animation="PlaceholderAnimation.Glow">
                <Placeholder Width="PlaceholderWidth.Col12" />
            </PlaceholderContainer>
        }
        else
        {
            @foreach (var settings in GridSettings.ColumnSettings)
            {
                <GridColumn TItem="TItem"
                            HeaderText="@settings.Header"
                            PropertyName="@settings.Name"
                            SortString="@settings.Name"
                            IsVisible="@settings.Visible"
                            Filterable="@settings.Filterable"
                            FilterValue="@settings.FilterValue"
                            SortKeySelector="@settings.SortSelector"
                >
                    <div class="text-truncate" style="max-width: 200px;" title="@settings.DisplaySelector(context)">
                        @settings.DisplaySelector(context)
                    </div>
                </GridColumn>
            }
        }
    </Grid>
</div>