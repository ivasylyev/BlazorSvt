@typeparam TItem
@typeparam TDetailItem
@inherits SvtComponentBase
<PageTitle>@PageTitle</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">@PageTitle</h1>
    <div class="d-flex gap-2">
        <Dropdown Color="DropdownColor.Secondary">
            <DropdownToggleButton Class="sibur-dna-btn">
                @L["GenericGrid.Reports"]
            </DropdownToggleButton>
            <DropdownMenu>
                <DropdownItem Type="DropdownItemType.Button"
                              @onclick="OnShortReportAsync">
                    @L["GenericGrid.ShortReport"]
                </DropdownItem>
                <DropdownItem Type="DropdownItemType.Button"
                              @onclick="OnFullReportAsync">
                    @L["GenericGrid.FullReport"]
                </DropdownItem>
            </DropdownMenu>
        </Dropdown>
        <Button Class="sibur-dna-btn" @onclick="ClearFiltersAsync">@L["GenericGrid.ResetFilters"]</Button>
        <Button Class="sibur-dna-btn" @onclick="ShowSettingsAsync">@L["GenericGrid.Settings"]</Button>
    </div>
</div>

<SettingsModal @ref="settingsModal"
               ColumnSettings="gridSettings?.GetGridColumnSettingsCopy()"
               OnOk="OnOkClick"
               OnCancel="OnCancelClick"
               OnReset="OnResetClick" />
<ReportConfirmModal @ref="reportConfirmModal" />
<div class="sibur-grid">
    <Grid @ref="grid"
          TItem="TItem"
          Class="table table-hover table-bordered table-striped"
          DataProvider="DataProvider"
          AllowFiltering="true"
          AllowPaging="true"
          AllowSorting="true"
          EnumFilterSelectText = "@L["GenericGrid.EnumFilterSelectText"]"
          PaginationItemsTextFormat="@L["GenericGrid.PaginationItemsTextFormat"]"
          FiltersTranslationProvider="GridFiltersTranslationProvider"
          AllowDetailView="AllowDetailView"
          RowKeySelector="DetailKeySelector"
          Responsive="true">

        @if (gridSettings is null)
        {
            <PlaceholderContainer Animation="PlaceholderAnimation.Glow">
                <Placeholder Width="PlaceholderWidth.Col12" />
            </PlaceholderContainer>
        }
        else
        {
            <GridColumns>
                @foreach (var settings in gridSettings.ColumnSettings)
                {
                    <GridColumn TItem="TItem"
                                HeaderText="@settings.Header"
                                PropertyName="@settings.Name"
                                SortString="@settings.Name"
                                IsVisible="@settings.Visible"
                                Filterable="@settings.Filterable"
                                FilterValue="@settings.FilterValue"
                                SortKeySelector="@settings.SortSelector"
                                >
                        <div class="cell-truncate" title="@settings.DisplaySelector(context)">
                            @settings.DisplaySelector(context)
                        </div>
                    </GridColumn>
                }

            </GridColumns>
            <GridDetailView TItem="TItem">
                <GenericDetailView TItem="TItem"
                                 TDetailItem="TDetailItem"
                                 Item="context"
                                 DetailDataProvider="DetailDataProvider"
                                 Template="DetailViewTemplate"/>
               
            </GridDetailView>
        }
    </Grid>
</div>