@typeparam TItem
@typeparam TDetailItem
@inherits SvtComponentBase
@if (isLoading)
{
    <div class="p-3">Loading...</div>
}
else if (errorMessage is not null)
{
    <div class="p-3 text-danger">@errorMessage</div>
}
else if (detail is not null)
{
    @Template?.Invoke(detail)

    <div class="card mb-3">
        <div class="card-header fw-bold">
            GROUP NAME
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var setting in detailSettings.GetGridDetailSettingsCopy())
                {
                    <div class="col-md-6 mb-2">
                        <label class="form-label text-muted">@setting.Header</label>
                        <div class="form-control">
                            @(setting.DisplaySelector(detail))
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}