@using BlazorSvt.Services.Shared
@inject PageTimingService TimingService
@inherits SvtComponentBase

<div>
    @if (TimingService.LoadDuration > TimeSpan.Zero)
    {
        <span>
            @string.Format(L["LoadTimePanel.LoadTimeFormat"], TimingService.LoadDuration.TotalSeconds)
        </span>
    }
    else
    {
        <span>@L["LoadTimePanel.NotLoaded"]</span>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        TimingService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TimingService.OnChange -= StateHasChanged;
    }
}