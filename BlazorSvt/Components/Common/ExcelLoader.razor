@typeparam TItem
@inherits SvtComponentBase

<div class="d-flex align-items-center gap-3 flex-wrap">
    <label class="btn sibur-dna-btn mb-0">
        @L["ExcelLoader.Load"]
        <InputFile OnChange="OnFileSelectedAsync"
                   accept=".xlsx,.xlsm,.xls"
                   class="d-none"
                   MaxAllowedSize="10485760"
                   disabled="@_isLoading" />
    </label>

    @if (_showProgress)
    {
        <div class="flex-grow-1" style="min-width: 12rem; max-width: 24rem;">
            <Progress>
                <ProgressBar Width="_progressPercent"
                             Label="@($"{_progressPercent:F0}%")"
                             Color="ProgressColor.Primary" />
            </Progress>
        </div>
    }
</div>
