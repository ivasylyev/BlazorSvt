@page "/legs"
@using BlazorSvt.Models.Dto
@inherits BaseGridPage<LegDto, LegDetailsDto>

<GenericGrid TItem="LegDto"
             TDetailItem="LegDetailsDto"
             DataProvider="DataProvider"
             DetailsDataProvider="DetailsDataProvider"
             PageTitle="@L["LegsGrid.Title"]"
             DetailKeySelector="l => l.Id"
             >

    <DetailViewTemplate Context="detail">
        <div class="p-3">
            @detail.Id
        </div>
    </DetailViewTemplate>

</GenericGrid>