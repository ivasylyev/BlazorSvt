@page "/load"
@inherits SvtComponentBase

<PageTitle>@L["Load.Title"]</PageTitle>

<h1 class="mb-4">@L["Load.Title"]</h1>

<div class="d-flex flex-column gap-4">
    <Card class="sibur-card">
        <CardBody>
            <CardTitle>@L["Load.WithoutProxy"]</CardTitle>
            <ExcelLoader OnLoaded="ImportAsync" />

            @if (_withoutProxy.SuccessMessage is not null)
            {
                <div class="alert alert-success mt-3 mb-0">@_withoutProxy.SuccessMessage</div>
            }
            else if (_withoutProxy.ErrorMessage is not null)
            {
                <div class="alert alert-danger mt-3 mb-0 d-flex align-items-center justify-content-between gap-3 flex-wrap">
                    <span>@_withoutProxy.ErrorMessage</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DownloadAsync">
                        @L["Load.DownloadErrors"]
                    </button>
                </div>
            }
        </CardBody>
    </Card>
</div>
