@page "/rates"
@using BlazorSvt.Models.Dto
@inherits BaseGridPage<RateDto, RateDetailDto>

<GenericGrid TItem="RateDto"
             TDetailItem="RateDetailDto"
             PageTitle="@L["RatesGrid.Title"]"
             DataProvider="DataProvider"
             DetailDataProvider="DetailDataProvider"
             DetailKeySelector="DetailKeySelector">

    <DetailViewTemplate Context="detail">
        <div class="mb-3">
            @GetCustomMessage(detail);
        </div>
    </DetailViewTemplate>

</GenericGrid>

