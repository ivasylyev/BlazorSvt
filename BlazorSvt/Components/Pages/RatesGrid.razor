@page "/rates"
@using BlazorSvt.Models.Dto
@inherits BaseGridPage<RateDto, RateDetailsDto>

<GenericGrid TItem="RateDto"
             TDetailItem="RateDetailsDto"
             DataProvider="DataProvider"
             DetailsDataProvider="DetailsDataProvider"
             PageTitle="@L["RatesGrid.Title"]"
             DetailKeySelector="rate => rate.Id"
             >

    <DetailViewTemplate Context="detail">
        <div class="p-3">
            @detail.Id
        </div>
    </DetailViewTemplate>

</GenericGrid>

