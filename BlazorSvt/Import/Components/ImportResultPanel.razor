@inherits SvtComponentBase
@using BlazorSvt.Import.Models
@using BlazorSvt.Platform.Reporting.Services
@inject IFileDownloadService FileDownloadService

@if (State.SuccessMessage is not null)
{
    <div class="alert alert-success mt-3 mb-0">@State.SuccessMessage</div>
}
else if (State.ErrorMessage is not null)
{
    <div class="alert alert-danger mt-3 mb-0 d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <span>@State.ErrorMessage</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DownloadAsync">
            @L["Load.DownloadErrors"]
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ImportState State { get; set; } = default!;

    private async Task DownloadAsync()
    {
        if (State.AnnotatedWorkbook is null)
        {
            return;
        }

        await FileDownloadService.DownloadFromBytesAsync(State.AnnotatedWorkbook, State.AnnotatedFileName);
    }
}
