@page "/load"
@inherits SvtComponentBase

<PageTitle>@L["Load.Title"]</PageTitle>

<h1 class="mb-4">@L["Load.Title"]</h1>

<div class="d-flex flex-column gap-4">
    <Card class="sibur-card">
        <CardBody>
            <CardTitle>@L["Load.WithoutProxy"]</CardTitle>
            <ExcelLoader OnLoaded="ImportAsync" />

            <ImportResultPanel State="_withoutProxy" />
        </CardBody>
    </Card>
</div>
