@inherits LayoutComponentBase

<BlazorBootstrapLayout StickyHeader="true">
    <HeaderSection>
        <HeaderMenu />
    </HeaderSection>

    <ContentSection>
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>

            <ErrorContent Context="ex">
                <ErrorDisplay Exception="ex"/>
            </ErrorContent>
        </ErrorBoundary>
    </ContentSection>

    <FooterSection>
        <div class="d-flex align-items-center w-100 column-gap-3 flex-nowrap">
            <div class="flex-shrink-0 text-nowrap">
                <LoadTimePanel />
            </div>
            <div class="flex-grow-1 text-end text-nowrap">
                <BuildInfoPanel />
            </div>
        </div>
    </FooterSection>
</BlazorBootstrapLayout>

<Preload />
