@page "/transportleg"
@using BlazorSvt.Modules.TransportLeg.Detail
@inherits BaseGridPage<TransportLegDto, TransportLegDetailDto>

<GenericGrid TItem="TransportLegDto"
             TDetailItem="TransportLegDetailDto"
             PageTitle="@EL["TransportLegGrid.Title"]"
             AllowDetailView = "true"
             DataProvider="DataProvider"
             DetailDataProvider="DetailDataProvider"
             DetailKeySelector="DetailKeySelector">

    <DetailViewTemplate Context="detail">
        <div class="mb-3">
            @GetCustomMessage(detail);
        </div>
    </DetailViewTemplate>

</GenericGrid>