@page "/legs"
@using BlazorSvt.Modules.Legs.List
@using BlazorSvt.Modules.Legs.Detail
@using BlazorSvt.Platform.Grid.Components
@inherits BaseGridPage<LegDto, LegDetailDto>

<GenericGrid TItem="LegDto"
             TDetailItem="LegDetailDto"
             PageTitle="@L["LegsGrid.Title"]"
             AllowDetailView = "true"
             DataProvider="DataProvider"
             DetailDataProvider="DetailDataProvider"
             DetailKeySelector="DetailKeySelector">

    <DetailViewTemplate Context="detail">
        <div class="mb-3">
            @GetCustomMessage(detail);
        </div>
    </DetailViewTemplate>

</GenericGrid>