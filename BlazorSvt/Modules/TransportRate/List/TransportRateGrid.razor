@page "/transportrate"
@using BlazorSvt.Modules.TransportRate.List
@using BlazorSvt.Modules.TransportRate.Detail
@using BlazorSvt.Platform.Grid.Components
@inherits BaseGridPage<TransportRateDto, TransportRateDetailDto>

<GenericGrid TItem="TransportRateDto"
             TDetailItem="TransportRateDetailDto"
             PageTitle="@EL["TransportRateGrid.Title"]"
             AllowDetailView="true"
             DataProvider="DataProvider"
             DetailDataProvider="DetailDataProvider"
             DetailKeySelector="DetailKeySelector">

    <DetailViewTemplate Context="detail">
        <div class="mb-3">
            @GetCustomMessage(detail);
        </div>
    </DetailViewTemplate>

</GenericGrid>


