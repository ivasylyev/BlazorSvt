{
  "PathBase": "/v2",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MdmDb": "Server=S001ITD-0084;Database=mdm;Trusted_Connection=false;User ID=SVT;Password=SVTsrv1!;MultipleActiveResultSets=true;Application Name=mdm-api;Encrypt=False;TrustServerCertificate=True;Max Pool Size=1000;",
    "DefaultQueryTimeoutSeconds": 30,
    "ReportQueryTimeoutSeconds": 300
  },

  "Reports": {
    "ShortReportConfirmationThreshold": 20000,
    "FullReportConfirmationThreshold": 5000,
    "ReportBatchSize": 10000
  },

  "Sync": {
    "Enabled": true,
    "IntervalSeconds": 90,
    "ReconcileAtTime": "02:00",
    "TimeZone": "Russian Standard Time",
    "CommandTimeoutSeconds": 300,
    "Blackout": {
      "Default": [
        { "From": "01:00", "To": "02:30" }
      ],
      "Saturday": [
        { "From": "01:00", "To": "02:30" },
        { "From": "04:00", "To": "06:00" }
      ]
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Enrichers.CorrelationId" ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/logs/v2/V2-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] [CorrId: {ShortCorrelationId}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
