@inherits SvtComponentBase
<Accordion>
    <AccordionItem Title="@L["ErrorDisplay.Title"]" Class="alert alert-danger m-3">
        <Content>
            @if (Exception is not null)
            {
                <div class="card card-body bg-dark text-light">
                    <div class="mt-2"><strong>@L["ErrorDisplay.Message"]</strong> @Exception.Message</div>
                    <div class="mt-2"><strong>@L["ErrorDisplay.Type"]</strong> @Exception.GetType().Name</div>
                    <div class="mt-4"><strong>@L["ErrorDisplay.StackTrace"]</strong></div>
                    <pre class="text-break" style="white-space: pre-wrap; overflow-wrap: anywhere;">
                        @Exception.StackTrace
                    </pre>
                </div>
            }            
        </Content>
    </AccordionItem>
</Accordion>
