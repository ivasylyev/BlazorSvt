@inject NavigationManager Nav
@inherits SvtComponentBase

<div class="sibur-header-wrapper">
    <div class="d-flex align-items-center w-100">

        <div class="d-flex align-items-center gap-2">
            <Button Class="@GetButtonClass(IsHomeActive())"
                    Type="ButtonType.Link"
                    To="">
                <Icon Name="@IconName.HouseDoorFill" Class="me-2"/>
                @L["HeaderMenu.Home"]
            </Button>

            @foreach (var group in DomainGroups)
            {
                <div class="sibur-domain-menu">
                    <button type="button"
                            class="btn dropdown-toggle @GetButtonClass(IsDomainActive(group))"
                            aria-haspopup="true">
                        @L[group.TextResourceKey]
                    </button>
                    <ul class="dropdown-menu sibur-domain-menu-panel">
                        @foreach (var item in group.Items)
                        {
                            <li>
                                <NavLink class="dropdown-item" href="@item.Url" Match="NavLinkMatch.All">
                                    @item.Text
                                </NavLink>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="d-flex align-items-center gap-2 ms-auto">
            @if (!string.IsNullOrWhiteSpace(CurrentUser.Login))
            {
                <span class="sibur-header-user text-nowrap"
                      title="@CurrentUser.Login">
                    @(string.IsNullOrWhiteSpace(CurrentUser.DisplayName)
                        ? CurrentUser.Login
                        : CurrentUser.DisplayName)
                </span>
            }
            <CultureSelector />
        </div>

    </div>
</div>
