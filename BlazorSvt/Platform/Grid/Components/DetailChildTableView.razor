@typeparam TRow
@inherits SvtComponentBase
@using BlazorSvt.Platform.Grid.Services
@inject IGridPageSizeService GridPageSizeService
@if (pageSize is not null)
{
    <div class="sibur-grid-detail-child-table">
        <Grid @key="Table"
              TItem="TRow"
              Class="table table-sm table-bordered mb-0"
              DataProvider="DataProvider"
              AllowFiltering="true"
              AutoHideFiltering="true"
              AllowPaging="true"
              AutoHidePaging="true"
              AllowSorting="true"
              PageSize="pageSize.Value"
              PageSizeSelectorVisible="false"
              EnumFilterSelectText="@L["GenericGrid.EnumFilterSelectText"]"
              PaginationItemsTextFormat="@L["GenericGrid.PaginationItemsTextFormat"]"
              EmptyText="@L["GenericGrid.EmptyText"]"
              FiltersTranslationProvider="GridFiltersTranslationProvider"
              Responsive="true">
            <GridColumns>
                @foreach (var column in Table.Columns)
                {
                    <GridColumn TItem="TRow"
                                HeaderText="@column.Header"
                                PropertyName="@column.Name"
                                SortString="@column.Name"
                                SortKeySelector="@column.SortKeySelector">
                        @column.DisplaySelector(context)
                    </GridColumn>
                }
            </GridColumns>
        </Grid>
    </div>
    @if (Table.IsTruncated)
    {
        <div class="text-muted small mt-1">@L["GenericDetailView.ChildRowsShown", Table.Rows.Count, Table.TotalCount]</div>
    }
}

@code {
    private int? pageSize;

    [Parameter, EditorRequired]
    public DetailChildTable<TRow> Table { get; set; } = default!;

    protected override async Task OnInitializedAsync() =>
        pageSize = await GridPageSizeService.GetAsync();

    private Task<GridDataProviderResult<TRow>> DataProvider(GridDataProviderRequest<TRow> request) =>
        Task.FromResult(DetailChildGridData.Apply(Table.Rows, request));

    private Task<IEnumerable<FilterOperatorInfo>> GridFiltersTranslationProvider() =>
        Task.FromResult(GridFilterOperatorTranslations.Create(L));
}
