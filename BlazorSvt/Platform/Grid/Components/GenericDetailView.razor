@typeparam TItem
@typeparam TDetailItem
@inherits SvtComponentBase
@if (errorMessage is not null)
{
    <div class="alert alert-danger mb-0">@errorMessage</div>
}
else if (isLoading || detailSettings is null)
{
    <div class="p-3">@L["GenericDetailView.Loading"]</div>
}
else if (detail is not null && BuildAccordion() is var layout)
{
    @Template?.Invoke(detail)

    @if (layout.Sections.Count >= 2)
    {
        <button type="button"
                class="accordion-button sibur-grid-detail-toggle-all"
                @onclick="ToggleAllAccordionItemsAsync">
            <Icon Name="@(allExpanded ? IconName.ArrowsCollapse : IconName.ArrowsExpand)" Class="me-2" />
            @(allExpanded ? L["GenericDetailView.CollapseAll"] : L["GenericDetailView.ExpandAll"])
        </button>
    }

    <Accordion @ref="accordion" AlwaysOpen="true">
        @foreach (var slot in layout.Sections)
        {
            if (slot.Kind == DetailAccordionSectionKind.ChildTable)
            {
                var child = layout.Children[slot.SourceIndex];
                <AccordionItem @key="@($"child:{child.Title}")" Title="@child.Title" Active="@slot.StartsExpanded" Class="sibur-grid-detail-child">
                    <Content>
                        @if (child.ErrorMessage is not null)
                        {
                            <div class="alert alert-danger mb-0">@child.ErrorMessage</div>
                        }
                        else if (child.Table is { } table)
                        {
                            <DynamicComponent Type="ChildTableViewType(table)" Parameters="ChildTableViewParameters(table)" />
                        }
                    </Content>
                </AccordionItem>
            }
            else
            {
                var group = layout.FieldGroups[slot.SourceIndex];
                <AccordionItem @key="@($"group:{group.Key}")" Title="@group.Key" Active="@slot.StartsExpanded">
                    <Content>
                        <div class="sibur-grid-detail-container">
                            @foreach (var setting in group.Value.Where(IsFieldVisible))
                            {
                                var marginClass = setting.HasMargin ? "mt-4" : string.Empty;
                                <div class="sibur-grid-detail-label @marginClass">@setting.Header:</div>
                                <div class="sibur-grid-detail-value @marginClass">@(setting.DisplaySelector(detail))</div>
                            }
                        </div>
                    </Content>
                </AccordionItem>
            }
        }
    </Accordion>
}
