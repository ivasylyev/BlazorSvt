@typeparam TItem
@typeparam TDetailItem
@inherits SvtComponentBase
@if (errorMessage is not null)
{
    <div class="p-3 text-danger">@errorMessage</div>
}
else if (isLoading || detailSettings is null)
{
    <div class="p-3">@L["GenericDetailView.Loading"]</div>
}
else if (detail is not null)
{
    @Template?.Invoke(detail)

    @if (GetVisibleGroupCount() >= 2)
    {
        <button type="button"
                class="accordion-button sibur-grid-detail-toggle-all"
                @onclick="ToggleAllAccordionItemsAsync">
            <Icon Name="@(allExpanded ? IconName.ArrowsCollapse : IconName.ArrowsExpand)" Class="me-2" />
            @(allExpanded ? L["GenericDetailView.CollapseAll"] : L["GenericDetailView.ExpandAll"])
        </button>
    }

    <Accordion @ref="accordion" AlwaysOpen="true">
        @foreach (var groupPair in detailSettings.GroupSettings)
        {
            if (groupPair.Value.Any(s => s.VisibleSelector(detail)))
            {
                <AccordionItem Title="@groupPair.Key" Active="true">
                    <Content>
                        <div class="sibur-grid-detail-container">
                            @foreach (var setting in groupPair.Value.Where(v => v.VisibleSelector(detail)))
                            {
                                var marginClass = setting.HasMargin ? "mt-4" : string.Empty;
                                <div class="sibur-grid-detail-label @marginClass">@setting.Header:</div>
                                <div class="sibur-grid-detail-value @marginClass">@(setting.DisplaySelector(detail))</div>
                            }
                        </div>
                    </Content>
                </AccordionItem>
            }
        }
    </Accordion>
}
